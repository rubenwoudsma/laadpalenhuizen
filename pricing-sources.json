        {
          "label": "MRA-E 6 dynamisch bevat EUR 0,34 en 0,36",
          "patterns": [
            "mra-e\\s+6.{0,80}dynamische.{0,300}0[,.]34.{0,160}0[,.]36"
          ]
        },
        {
          "label": "MRA-E DC blijft EUR 0,54 incl. btw",
          "patterns": [
            "flevoland.{0,80}noord-holland.{0,80}utrecht.{0,80}mra-e.{0,120}(?:€\\s*)?0[,.]54"
          ]

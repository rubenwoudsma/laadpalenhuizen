        {
          "label": "MRA-E 2 t/m 5 blijft EUR 0,48 incl. btw",
          "patterns": [
            "mra-e\\s+2\\s*(?:t/m|t\\s+m)\\s*5.{0,160}(?:€\\s*)?0[,.]48"
          ]
